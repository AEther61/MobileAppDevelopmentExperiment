<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Experiment1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Experiment1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 实验二：4 个布局界面。ActionBar 显示的标题就是这里的 android:label。 -->
        <activity
            android:name=".LinearLayoutActivity"
            android:exported="false"
            android:label="@string/title_linear_layout"
            android:theme="@style/Theme.Experiment1.LinearLayout" />

        <activity
            android:name=".TableLayoutActivity"
            android:exported="false"
            android:label="@string/title_table_layout"
            android:theme="@style/Theme.Experiment1.TableLayout" />

        <activity
            android:name=".ConstraintCalculatorActivity"
            android:exported="false"
            android:label="@string/title_constraint_calculator"
            android:theme="@style/Theme.Experiment1.Calculator" />

        <activity
            android:name=".SpaceTravelActivity"
            android:exported="false"
            android:label="@string/title_space_travel"
            android:theme="@style/Theme.Experiment1" />
    </application>

</manifest>